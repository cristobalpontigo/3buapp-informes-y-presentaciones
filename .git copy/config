[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/cristobalpontigo/3buapp-informes-y-presentaciones.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "ajustes-presentacion-v2"]
	vscode-merge-base = origin/main
[branch "chore/minor-fix"]
	vscode-merge-base = origin/main
